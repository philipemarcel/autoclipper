# ==============================================================================
# 1. TWITCH API (Conta gratuita comum de espectador -> https://dev.twitch.tv/console)
# ==============================================================================
TWITCH_CLIENT_ID=seu_twitch_client_id
TWITCH_CLIENT_SECRET=seu_twitch_client_secret

# ==============================================================================
# 2. IA (Gemini para Direção/Copy + Groq gratuito para Transcrição ultra-rápida)
# ==============================================================================
GEMINI_API_KEY=sua_chave_gemini_ai_studio
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=sua_chave_gratuita_groq_cloud

# ==============================================================================
# 3. GOOGLE DRIVE 20 TB (Use GDRIVE_MOUNT_PATH no Colab/PC OU GDRIVE_TOKEN_JSON na nuvem)
# ==============================================================================
# No Google Colab, aponte direto para a pasta montada:
GDRIVE_MOUNT_PATH=
# No GitHub Actions, cole o JSON gerado em 30s pelo script `python scripts/auth_gdrive.py`:
GDRIVE_TOKEN_JSON=
GDRIVE_ROOT_FOLDER_NAME=TwitchAutoClipper

# ==============================================================================
# 4. DISCORD (Fila de aprovação de 1 clique)
# ==============================================================================
DISCORD_BOT_TOKEN=seu_token_do_bot_discord
DISCORD_CHANNEL_ID=id_do_canal_de_aprovacao

# ==============================================================================
# 5. REDES SOCIAIS (Instagram Reels Graph API + TikTok Content Posting API)
# ==============================================================================
IG_ACCOUNT_ID=id_conta_instagram_creator_ou_business
IG_ACCESS_TOKEN=token_longa_duracao_meta_graph_api

TIKTOK_ACCESS_TOKEN=token_acesso_tiktok_api
